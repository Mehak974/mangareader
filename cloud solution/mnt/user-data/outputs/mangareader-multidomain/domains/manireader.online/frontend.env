# ════════════════════════════════════════════════════════════════════════════
# manireader.online — Frontend environment variables
# ════════════════════════════════════════════════════════════════════════════

DOMAIN_PROFILE=manireader.online
NEXT_PUBLIC_SITE_URL=https://manireader.online
NEXT_PUBLIC_SITE_NAME=ManiReader

NEXT_PUBLIC_API_URL=https://api.manireader.online
API_URL=https://api.manireader.online
NEXT_PUBLIC_SCRAPER_URL=https://api.manireader.online

# Separate Neon project — manireader_online database
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-ZZZZ.us-east-2.aws.neon.tech/manireader_online?sslmode=require

AUTH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET_FOR_MANIREADER
COOKIE_DOMAIN=.manireader.online

# A-ADS — different unit registered under manireader.online
NEXT_PUBLIC_AADS_UNIT_ID=REPLACE_WITH_MANIREADER_AADS_UNIT_ID
NEXT_PUBLIC_AADS_BG_COLOR=0E0F14
NEXT_PUBLIC_AADS_TITLE_COLOR=F97316

# Pop ads
NEXT_PUBLIC_POP_ADS_KEY=manireader

NEXT_PUBLIC_ADSENSE_ID=

NEXT_PUBLIC_GOOGLE_VERIFICATION=REPLACE_WITH_GOOGLE_VERIFICATION_CODE_FOR_MANIREADER
NEXT_PUBLIC_BING_VERIFICATION=REPLACE_WITH_BING_VERIFICATION_CODE_FOR_MANIREADER

INDEXNOW_KEY=REPLACE_WITH_INDEXNOW_KEY_FOR_MANIREADER

NEXT_PUBLIC_GA_ID=G-ZZZZZZZZZZ

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
