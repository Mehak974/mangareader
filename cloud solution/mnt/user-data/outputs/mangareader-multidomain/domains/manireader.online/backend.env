# ════════════════════════════════════════════════════════════════════════════
# manireader.online — Backend environment variables
# ════════════════════════════════════════════════════════════════════════════

DOMAIN_PROFILE=manireader.online

PORT=3003
NODE_ENV=production

DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-ZZZZ.us-east-2.aws.neon.tech/manireader_online?sslmode=require

ADMIN_TOKEN=REPLACE_WITH_32_BYTE_HEX_ADMIN_TOKEN_MANIREADER
CSRF_SECRET=REPLACE_WITH_32_BYTE_HEX_CSRF_SECRET_MANIREADER

ALLOWED_ORIGINS=https://manireader.online,https://www.manireader.online

REDIS_URL=redis://default:PASSWORD@zzz.upstash.io:6379

SCRAPER_PROXY_URL=
SCRAPER_PROXY_ROTATION=false
SCRAPER_PROXY_LIST=[]

FLARESOLVERR_URL=http://flaresolverr:8191/v1

PUPPETEER_CONCURRENCY=2
FETCH_HTML_CONCURRENCY=15

MAINTENANCE_MODE=false

JWT_SECRET=REPLACE_WITH_JWT_SECRET_FOR_MANIREADER
