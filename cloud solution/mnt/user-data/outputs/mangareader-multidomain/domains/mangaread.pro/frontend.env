# ════════════════════════════════════════════════════════════════════════════
# mangaread.pro — Frontend environment variables
# ════════════════════════════════════════════════════════════════════════════

DOMAIN_PROFILE=mangaread.pro
NEXT_PUBLIC_SITE_URL=https://mangaread.pro
NEXT_PUBLIC_SITE_NAME=MangaRead

NEXT_PUBLIC_API_URL=https://api-mangaread.railway.app
API_URL=https://api-mangaread.railway.app
NEXT_PUBLIC_SCRAPER_URL=https://api-mangaread.railway.app

# Separate Neon project — mangaread_pro database
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-YYYY.us-east-2.aws.neon.tech/mangaread_pro?sslmode=require

AUTH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET_FOR_MANGAREAD_PRO
COOKIE_DOMAIN=.mangaread.pro

# A-ADS — different unit registered under mangaread.pro
NEXT_PUBLIC_AADS_UNIT_ID=REPLACE_WITH_MANGAREAD_AADS_UNIT_ID
NEXT_PUBLIC_AADS_BG_COLOR=0C1220
NEXT_PUBLIC_AADS_TITLE_COLOR=38BDF8

# Pop ads
NEXT_PUBLIC_POP_ADS_KEY=mangaread_pro

NEXT_PUBLIC_ADSENSE_ID=

NEXT_PUBLIC_GOOGLE_VERIFICATION=REPLACE_WITH_GOOGLE_VERIFICATION_CODE_FOR_MANGAREAD
NEXT_PUBLIC_BING_VERIFICATION=REPLACE_WITH_BING_VERIFICATION_CODE_FOR_MANGAREAD

INDEXNOW_KEY=REPLACE_WITH_INDEXNOW_KEY_FOR_MANGAREAD

NEXT_PUBLIC_GA_ID=G-YYYYYYYYYY

NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
