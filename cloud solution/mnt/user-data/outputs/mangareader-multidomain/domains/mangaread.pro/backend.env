# ════════════════════════════════════════════════════════════════════════════
# mangaread.pro — Backend environment variables
# ════════════════════════════════════════════════════════════════════════════

DOMAIN_PROFILE=mangaread.pro

PORT=3002
NODE_ENV=production

DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-YYYY.us-east-2.aws.neon.tech/mangaread_pro?sslmode=require

ADMIN_TOKEN=REPLACE_WITH_32_BYTE_HEX_ADMIN_TOKEN_MANGAREAD
CSRF_SECRET=REPLACE_WITH_32_BYTE_HEX_CSRF_SECRET_MANGAREAD

ALLOWED_ORIGINS=https://mangaread.pro,https://www.mangaread.pro

REDIS_URL=redis://default:PASSWORD@yyy.upstash.io:6379

SCRAPER_PROXY_URL=
SCRAPER_PROXY_ROTATION=false
SCRAPER_PROXY_LIST=[]

FLARESOLVERR_URL=http://flaresolverr:8191/v1

PUPPETEER_CONCURRENCY=2
FETCH_HTML_CONCURRENCY=15

MAINTENANCE_MODE=false

JWT_SECRET=REPLACE_WITH_JWT_SECRET_FOR_MANGAREAD
