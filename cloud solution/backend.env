# ════════════════════════════════════════════════════════════════════════════
# mangareader.pro — Backend environment variables
# Set these in Railway/Render → Service → Variables
# ════════════════════════════════════════════════════════════════════════════

# ── Domain identity ───────────────────────────────────────────────────────────
DOMAIN_PROFILE=mangareader.pro

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Database (same Neon project as frontend — separate connection pool) ───────
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/mangareader_pro?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=REPLACE_WITH_32_BYTE_HEX_ADMIN_TOKEN
CSRF_SECRET=REPLACE_WITH_32_BYTE_HEX_CSRF_SECRET

# ── CORS (must exactly match frontend domain) ─────────────────────────────────
ALLOWED_ORIGINS=https://mangareader.pro,https://www.mangareader.pro

# ── Redis (Upstash recommended — free tier works) ────────────────────────────
# Get from: https://upstash.com → Redis → Create Database → REST API
REDIS_URL=redis://default:PASSWORD@xxx.upstash.io:6379
# OR for Upstash REST-style (ioredis compatible):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxxxx

# ── Anti-blocking / proxy (optional but STRONGLY recommended for 10k/day) ───
# Without proxies the scraper IPs will be blocked. Options:
#
# Option A: Residential proxy service (best)
#   BrightData, Oxylabs, SmartProxy etc.
#   SCRAPER_PROXY_URL=http://user:pass@gate.brightdata.com:22225
#
# Option B: Rotating proxy list (JSON array of {host,port,protocol,user,pass})
#   SCRAPER_PROXY_ROTATION=true
#   SCRAPER_PROXY_LIST=[{"host":"proxy1.example.com","port":8080,"protocol":"http"},{"host":"proxy2.example.com","port":8080}]
#
SCRAPER_PROXY_URL=
SCRAPER_PROXY_ROTATION=false
SCRAPER_PROXY_LIST=[]

# ── FlareSolverr (self-hosted Cloudflare bypass) ─────────────────────────────
# Deploy from: https://github.com/FlareSolverr/FlareSolverr
# On Railway: add as a companion service
FLARESOLVERR_URL=http://flaresolverr:8191/v1

# ── Puppeteer concurrency (keep at 1-2 on Railway hobby plans) ───────────────
PUPPETEER_CONCURRENCY=2
FETCH_HTML_CONCURRENCY=15

# ── Maintenance mode ──────────────────────────────────────────────────────────
MAINTENANCE_MODE=false

# ── JWT (for admin panel) ─────────────────────────────────────────────────────
JWT_SECRET=REPLACE_WITH_JWT_SECRET_FOR_MANGAREADER
