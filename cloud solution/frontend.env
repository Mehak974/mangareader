# ════════════════════════════════════════════════════════════════════════════
# mangareader.pro — Frontend environment variables
# Set these in Vercel → Project Settings → Environment Variables
# ════════════════════════════════════════════════════════════════════════════

# ── Domain identity (CRITICAL — must match exactly) ──────────────────────────
DOMAIN_PROFILE=mangareader.pro
NEXT_PUBLIC_SITE_URL=https://mangareader.pro
NEXT_PUBLIC_SITE_NAME=MangaReader

# ── Backend API (set to your Railway/Render URL for this domain's backend) ───
NEXT_PUBLIC_API_URL=https://api-mangareader.railway.app
API_URL=https://api-mangareader.railway.app
NEXT_PUBLIC_SCRAPER_URL=https://api-mangareader.railway.app

# ── Database (Neon PostgreSQL — separate project per domain) ─────────────────
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-XXXX.us-east-2.aws.neon.tech/mangareader_pro?sslmode=require

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET_FOR_MANGAREADER_PRO
COOKIE_DOMAIN=.mangareader.pro

# ── A-ADS (a-ads.com) banner ads ─────────────────────────────────────────────
# Your unit ID from https://a-ads.com → Sites → Advertising Units
NEXT_PUBLIC_AADS_UNIT_ID=2454751
NEXT_PUBLIC_AADS_BG_COLOR=0A0612
NEXT_PUBLIC_AADS_TITLE_COLOR=A855F7

# ── Pop-ads (Propeller / purple-text etc.) ───────────────────────────────────
# Key maps to script URL in AdScriptLoader.tsx → POP_ADS_SCRIPTS
NEXT_PUBLIC_POP_ADS_KEY=mangareader_pro

# ── Google AdSense (leave empty if using A-ADS only) ─────────────────────────
NEXT_PUBLIC_ADSENSE_ID=

# ── Google verification ───────────────────────────────────────────────────────
# Get from: Google Search Console → Add property → HTML tag method
NEXT_PUBLIC_GOOGLE_VERIFICATION=REPLACE_WITH_GOOGLE_VERIFICATION_CODE
NEXT_PUBLIC_BING_VERIFICATION=REPLACE_WITH_BING_VERIFICATION_CODE

# ── IndexNow (Bing instant indexing) ─────────────────────────────────────────
# Generate a key at https://www.bing.com/indexnow
# Also drop the key as /public/<key>.txt
INDEXNOW_KEY=REPLACE_WITH_INDEXNOW_KEY

# ── Analytics ─────────────────────────────────────────────────────────────────
# Vercel Analytics auto-enabled on Vercel. For GA4:
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Next.js ───────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
