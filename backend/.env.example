# ── SERVER ────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── SECURITY ──────────────────────────────────────────────────────────────────
# All of these are REQUIRED — the server now refuses to start without them
# rather than falling back to an insecure default.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN="your-32-byte-hex-admin-token"
JWT_SECRET="your-64-byte-hex-jwt-secret"
ADMIN_PASSWORD="a-strong-unique-password-not-admin"
CSRF_SECRET="your-32-byte-hex-csrf-secret"

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000"

# ── MAINTENANCE ───────────────────────────────────────────────────────────────
MAINTENANCE_MODE="false"

# ── REDIS (for caching + rate limiting) ───────────────────────────────────────
# If not set, the server falls back to in-memory cache (NodeCache).
# Example: REDIS_URL="redis://localhost:6379" or "redis://redis:6379" (docker)
REDIS_URL="redis://localhost:6379"

# ── FLARESOLVERR (Cloudflare bypass for scraped sites) ────────────────────────
# Run FlareSolverr as a sidecar (see docker-compose.yml).
# Example: FLARESOLVERR_URL="http://localhost:8191/v1"
FLARESOLVERR_URL="http://localhost:8191/v1"

# ── SCRAPER PROXIES (optional, for IP rotation) ────────────────────────────────
# Single proxy:
# SCRAPER_PROXY_URL="http://user:pass@proxyhost:port"
# Rotating proxies (JSON array):
# SCRAPER_PROXY_ROTATION=true
# SCRAPER_PROXY_LIST='[{"host":"proxy1.example.com","port":8080,"protocol":"http"},{"host":"proxy2.example.com","port":8080,"protocol":"http"}]'

# ── RUNTIME TUNING ───────────────────────────────────────────────────────────
# Max concurrent HTTP fetches (default: 15). Lower on memory-constrained hosts.
FETCH_HTML_CONCURRENCY=15
# Max concurrent Puppeteer/Chrome instances (default: 1). CRITICAL for OOM prevention.
PUPPETEER_CONCURRENCY=1
