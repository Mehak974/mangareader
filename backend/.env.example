# ── SECURITY ──────────────────────────────────────────────────────────────────
# All of these are REQUIRED — the server now refuses to start without them
# rather than falling back to an insecure default.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN="your-32-byte-hex-admin-token"
JWT_SECRET="your-64-byte-hex-jwt-secret"
ADMIN_PASSWORD="a-strong-unique-password-not-admin"
CSRF_SECRET="your-32-byte-hex-csrf-secret"

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS="http://localhost:3000"

# ── MAINTENANCE ───────────────────────────────────────────────────────────────
MAINTENANCE_MODE="false"
