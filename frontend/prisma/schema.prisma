// Prisma schema for the Manga platform APP domain (auth, editorial CMS, community,
// security). The Express scraper owns a separate set of raw-`pg` tables in the same
// database (manga, chapters, metadata, authors, tags, genres, ...). To avoid any
// collision, every model here is mapped to a distinct, app-scoped table name.
//
// Migration to Neon requires only swapping DATABASE_URL — no schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTH & USERS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  EDITOR
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash") // null for OAuth-only accounts
  displayName   String    @map("display_name")
  avatarUrl     String?   @map("avatar_url")
  role          UserRole  @default(USER)
  emailVerified DateTime? @map("email_verified")
  banned        Boolean   @default(false)
  bannedReason  String?   @map("banned_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  sessions      Session[]
  articles      Article[]      @relation("ArticleCreatedBy")
  auditLogs     AuditLog[]
  editorProfile EditorialAuthor?
  comments      Comment[]
  libraries     Library[]

  @@index([role])
  @@map("users")
}

// Server-side sessions (opaque token stored hashed; raw token lives only in the cookie).
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────────
// EDITORIAL CONTENT (E-E-A-T / Helpful Content / AdSense)
// ─────────────────────────────────────────────────────────────────────────────

// Public-facing editorial author/persona (distinct from the scraper's manga authors).
model EditorialAuthor {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  bio         String?
  avatarUrl   String?   @map("avatar_url")
  credentials String? // shown for E-E-A-T (experience/expertise)
  socialLinks Json?     @map("social_links") // { twitter, mastodon, website, ... }
  userId      String?   @unique @map("user_id") // optional link to a login account
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  articles Article[] @relation("ArticleByline")

  @@map("editorial_authors")
}

enum ContentType {
  BLOG
  REVIEW
  GUIDE
  RECOMMENDATION
  EDITORIAL
  NEWS
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")

  articles Article[]

  @@map("editorial_categories")
}

model ArticleTag {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String    @unique
  articles Article[]

  @@map("article_tags")
}

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  excerpt     String?
  body        String // markdown source
  coverImage  String?       @map("cover_image")
  contentType ContentType   @default(BLOG) @map("content_type")
  status      ContentStatus @default(DRAFT)

  // authorship
  bylineId  String? @map("byline_id") // public author persona
  createdById String? @map("created_by_id") // login account that authored it

  // scheduling / lifecycle
  publishedAt  DateTime? @map("published_at")
  scheduledFor DateTime? @map("scheduled_for")

  // SEO / GEO / AEO
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  canonicalUrl   String? @map("canonical_url")
  ogImage        String? @map("og_image")

  // relations to scraper manga are by id (cross-owner, so no FK): array of manga ids
  relatedMangaIds String[] @map("related_manga_ids")

  readingMinutes Int      @default(0) @map("reading_minutes")
  viewCount      Int      @default(0) @map("view_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  byline     EditorialAuthor? @relation("ArticleByline", fields: [bylineId], references: [id], onDelete: SetNull)
  createdBy  User?            @relation("ArticleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  categoryId String?          @map("category_id")
  category   Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       ArticleTag[]
  review     Review?
  comments   Comment[]

  @@index([status, publishedAt])
  @@index([contentType, status])
  @@index([categoryId])
  @@map("articles")
}

// Structured review data (1:1 with a REVIEW-type Article). Scores are 0-100.
model Review {
  id           String  @id @default(cuid())
  articleId    String  @unique @map("article_id")
  mangaId      String? @map("manga_id") // scraper manga id, if the review targets one
  storyScore       Int? @map("story_score")
  charactersScore  Int? @map("characters_score")
  artworkScore     Int? @map("artwork_score")
  worldScore       Int? @map("world_score")
  pacingScore      Int? @map("pacing_score")
  overallScore     Int? @map("overall_score")
  strengths    String[]
  weaknesses   String[]
  verdict      String?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY
// ─────────────────────────────────────────────────────────────────────────────

enum MessageType {
  CONTACT
  BUG_REPORT
  FEATURE_REQUEST
  COMPLAINT
}

enum MessageStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  SPAM
}

model ContactMessage {
  id        String        @id @default(cuid())
  type      MessageType   @default(CONTACT)
  name      String
  email     String
  subject   String?
  message   String
  status    MessageStatus @default(NEW)
  ip        String?
  userAgent String?       @map("user_agent")
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([status, type])
  @@map("contact_messages")
}

model NewsletterSubscriber {
  id          String    @id @default(cuid())
  email       String    @unique
  confirmed   Boolean   @default(false)
  token       String    @unique
  confirmedAt DateTime? @map("confirmed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("newsletter_subscribers")
}

// ─────────────────────────────────────────────────────────────────────────────
// SECURITY & AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String // e.g. "article.publish", "user.ban"
  entity    String? // e.g. "Article"
  entityId  String?  @map("entity_id")
  meta      Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// Login attempts for rate limiting / credential-stuffing defense & security dashboard.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  success   Boolean  @default(false)
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY DISCUSSION
// ─────────────────────────────────────────────────────────────────────────────

enum CommentStatus {
  VISIBLE
  HIDDEN // soft-removed by a moderator
}

// Threaded discussion attached to either a manga (scraper id, no FK) or an
// editorial Article. Exactly one target is set per comment.
model Comment {
  id        String        @id @default(cuid())
  body      String
  status    CommentStatus @default(VISIBLE)

  userId String @map("user_id")

  // Targets — exactly one is non-null.
  mangaId   String?  @map("manga_id") // scraper manga id (cross-owner, no FK)
  articleId String?  @map("article_id")

  // Threading: a top-level comment has null parentId.
  parentId String?  @map("parent_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  article  Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentReplies")

  @@index([mangaId, status, createdAt])
  @@index([articleId, status, createdAt])
  @@index([parentId])
  @@index([userId])
  @@map("comments")
}

// ─────────────────────────────────────────────────────────────────────────────
// USER LIBRARIES (multi-library manga bookmarks)
// ─────────────────────────────────────────────────────────────────────────────

model Library {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  manga LibraryManga[]

  @@unique([userId, name])
  @@index([userId])
  @@map("libraries")
}

model LibraryManga {
  id        String   @id @default(cuid())
  libraryId String   @map("library_id")
  mangaId   String   @map("manga_id")
  title     String
  cover     String?
  ongoing   Boolean  @default(true)
  rating    Float?
  genre     String?
  addedAt   DateTime @default(now()) @map("added_at")

  library Library @relation(fields: [libraryId], references: [id], onDelete: Cascade)

  @@unique([libraryId, mangaId])
  @@index([libraryId])
  @@map("library_manga")
}
