# ── DATABASE ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── BACKEND (Express scraper) ─────────────────────────────────────────────────
# Both vars point to the same backend — NEXT_PUBLIC_ is used client-side
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_SCRAPER_URL="http://localhost:3001"
API_URL="http://localhost:3001"

# ── AUTH ──────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
AUTH_SECRET="your-64-byte-hex-secret-here-minimum-32-chars-required-in-production"

# ── SITE ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MangaReader"

# ── ADS (REQUIRED before launch — without these the AdBanner renders empty) ───
# Per-domain values are set as defaults in src/lib/site-config.ts; override here
# only if you want different values per Vercel project.
# NEXT_PUBLIC_AADS_UNIT_ID="2454751"
# NEXT_PUBLIC_AADS_BG_COLOR="0A0612"
# NEXT_PUBLIC_AADS_TITLE_COLOR="A855F7"
# NEXT_PUBLIC_POP_ADS_KEY=""
# NEXT_PUBLIC_ADSENSE_ID=""
# NEXT_PUBLIC_GOOGLE_VERIFICATION=""
# NEXT_PUBLIC_BING_VERIFICATION=""

# ── SEO / INDEXNOW ─────────────────────────────────────────────────────────────
# Generate: python3 -c "import secrets; print(secrets.token_hex(16))"
# Then create public/<key>.txt containing just the key (see src/lib/indexnow.ts).
INDEXNOW_KEY="generate-a-random-hex-key-and-set-it-here"
